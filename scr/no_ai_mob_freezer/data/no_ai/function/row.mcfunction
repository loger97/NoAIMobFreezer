$execute if score $(id) no_ai_sel matches 1 run tellraw @s [{"text": "  [X] ", "color": "green", "bold": true, "click_event": {"action": "run_command", "command": "/function no_ai:toggle {id:$(id)}"}, "hover_event": {"action": "show_text", "value": "Selected - click to deselect"}}, {"text": "$(name)", "color": "white"}]
$execute unless score $(id) no_ai_sel matches 1 run tellraw @s [{"text": "  [ ] ", "color": "gray", "bold": true, "click_event": {"action": "run_command", "command": "/function no_ai:toggle {id:$(id)}"}, "hover_event": {"action": "show_text", "value": "Not selected - click to select"}}, {"text": "$(name)", "color": "gray"}]
