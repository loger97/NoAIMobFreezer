tellraw @s {"text":"--- No_AI Mob Freezer ---","color":"gold","bold":true}
tellraw @s {"text":"Name a mob 'No_AI' to freeze it. Rename it to let it move again.","color":"gray"}
execute if score $config no_ai_config matches 0 run tellraw @s [{"text": "Current mode: ", "color": "yellow"}, {"text": "Hostile Mobs", "color": "red", "bold": true}]
execute if score $config no_ai_config matches 1 run tellraw @s [{"text": "Current mode: ", "color": "yellow"}, {"text": "Peaceful Mobs", "color": "green", "bold": true}]
execute if score $config no_ai_config matches 3 run tellraw @s [{"text": "Current mode: ", "color": "yellow"}, {"text": "Only Certain Mobs", "color": "light_purple", "bold": true}]
execute if score $config no_ai_config matches 2 run tellraw @s [{"text": "Current mode: ", "color": "yellow"}, {"text": "All Mobs", "color": "aqua", "bold": true}]
tellraw @s [{"text": "[Hostile Mobs]", "color": "red", "bold": true, "click_event": {"action": "run_command", "command": "/function no_ai:mode/hostile"}, "hover_event": {"action": "show_text", "value": "Set mode: Hostile Mobs"}}, {"text": " "}, {"text": "[Peaceful Mobs]", "color": "green", "bold": true, "click_event": {"action": "run_command", "command": "/function no_ai:mode/peaceful"}, "hover_event": {"action": "show_text", "value": "Set mode: Peaceful Mobs"}}, {"text": " "}, {"text": "[Only Certain Mobs]", "color": "light_purple", "bold": true, "click_event": {"action": "run_command", "command": "/function no_ai:mode/custom"}, "hover_event": {"action": "show_text", "value": "Set mode: Only Certain Mobs"}}, {"text": " "}, {"text": "[All Mobs]", "color": "aqua", "bold": true, "click_event": {"action": "run_command", "command": "/function no_ai:mode/all"}, "hover_event": {"action": "show_text", "value": "Set mode: All Mobs"}}, {"text": " "}]
execute if score $config no_ai_config matches 3 run function no_ai:list
